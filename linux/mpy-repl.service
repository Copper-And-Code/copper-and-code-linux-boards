[Unit]
Description=MicroPython REPL on CDC-ACM and TCP
Requires=mpy-usb-composite.service
After=mpy-usb-composite.service
# Restart=always must never give up, or a crash loop leaves the board without a REPL.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# The hub pings every few seconds; if it stops, systemd restarts the service.
WatchdogSec=10
WorkingDirectory=/usr/local/mpy/fs
Environment=MICROPYPATH=.frozen:/usr/local/mpy/fs:/usr/local/mpy/fs/lib
# The terminal the Linux programs started from MicroPython see (ansiterm on the display, or a
# terminal on the PC): without it ls, bash and vi use no colours and no full-screen features.
Environment=TERM=xterm-256color
# Also shown on the ready screen.
Environment=MPY_REPL_TCP=192.168.7.1:8266
# One MicroPython process on a pseudo-terminal, shared by the USB serial port and one TCP client
# on the USB network only (no authentication). The hub restarts MicroPython when it exits.
ExecStart=/usr/local/mpy/bin/mpy-repl-hub --tty /dev/ttyGS0 --listen ${MPY_REPL_TCP} -- /usr/local/mpy/bin/micropython /usr/local/mpy/lib/mpy_launcher.py
Restart=always
RestartSec=0
# Real-time priority, low among real-time tasks (the kernel's interrupt threads run at 50): busy
# Linux programs no longer delay the GUI and the requests to a Cortex-M4 (measured with two busy
# processes: the slowest 1% of requests from 8 ms to about 1.5 ms). The kernel keeps 5% of every
# second for normal tasks (sched_rt_runtime_us), so a Python loop that never sleeps cannot freeze
# Linux, and the programs MicroPython starts (linuxproc: gst-play, shells) run at normal priority.
# To go without it: a drop-in with CPUSchedulingPolicy=other.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10

[Install]
WantedBy=multi-user.target
