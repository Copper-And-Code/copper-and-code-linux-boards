[Unit]
Description=MicroPython REPL on CDC-ACM
Requires=mpy-usb-composite.service
After=mpy-usb-composite.service
ConditionPathExists=/dev/ttyGS0
# Restart=always must never give up, or a crash loop leaves the board without a REPL.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/usr/local/mpy/fs
Environment=MICROPYPATH=.frozen:/usr/local/mpy/fs:/usr/local/mpy/fs/lib
ExecStartPre=/usr/bin/stty -F /dev/ttyGS0 raw isig -echo susp undef quit undef
ExecStart=/usr/local/mpy/bin/micropython /usr/local/mpy/lib/mpy_launcher.py
Restart=always
RestartSec=0
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyGS0
TTYReset=no

[Install]
WantedBy=multi-user.target
