[Unit]
Description=MicroPython REPL on CDC-ACM
Requires=mpy-usb-composite.service
After=mpy-usb-composite.service
ConditionPathExists=/dev/ttyGS0

[Service]
Type=simple
WorkingDirectory=/usr/local/mpy/fs
Environment=MICROPYPATH=/usr/local/mpy/fs:/usr/local/mpy/fs/lib
ExecStartPre=/usr/bin/stty -F /dev/ttyGS0 raw isig -echo
ExecStart=/usr/local/mpy/bin/micropython /usr/local/mpy/lib/mpy_launcher.py
Restart=always
RestartSec=0
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyGS0
TTYReset=no

[Install]
WantedBy=multi-user.target
