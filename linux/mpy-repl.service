[Unit]
Description=MicroPython REPL on CDC-ACM and TCP
Requires=mpy-usb-composite.service
After=mpy-usb-composite.service
# Restart=always must never give up, or a crash loop leaves the board without a REPL.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# The hub pings every few seconds; if it stops, systemd restarts the service.
WatchdogSec=10
WorkingDirectory=/usr/local/mpy/fs
Environment=MICROPYPATH=.frozen:/usr/local/mpy/fs:/usr/local/mpy/fs/lib
# The terminal the Linux programs started from MicroPython see (ansiterm on the display, or a
# terminal on the PC): without it ls, bash and vi use no colours and no full-screen features.
Environment=TERM=xterm-256color
# Also shown on the ready screen.
Environment=MPY_REPL_TCP=192.168.7.1:8266
# The layout of the keyboards plugged into the board: us, it, or none. To change it:
#   systemctl edit mpy-repl     [Service]  Environment=MPY_KEYBOARD=it
Environment=MPY_KEYBOARD=us
# MicroPython's heap: 8 MB, for the screen buffers of a 1280x720 monitor (the default is 1 MB).
# One MicroPython process on a pseudo-terminal, shared by the USB serial port, one TCP client on
# the USB network only (no authentication) and the keyboards. The hub restarts MicroPython when
# it exits.
# The raw REPL survives a soft reset (mpyrepl keeps it in /run/mpy-repl-mode), not a restart of
# the service: a tool that left it on would otherwise leave the board with no screen and no shell.
ExecStartPre=-/bin/rm -f /run/mpy-repl-mode
ExecStart=/usr/local/mpy/bin/mpy-repl-hub --tty /dev/ttyGS0 --listen ${MPY_REPL_TCP} --keyboard ${MPY_KEYBOARD} -- /usr/local/mpy/bin/micropython -X heapsize=8M /usr/local/mpy/lib/mpy_launcher.py
Restart=always
RestartSec=0
# Real-time priority comes from the board's drop-in (board.conf, written by install.sh), on boards
# with more than one core only: see there.

[Install]
WantedBy=multi-user.target
