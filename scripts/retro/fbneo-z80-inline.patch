+// Without the ZX Spectrum's memory contention (ULA_VARIANT_NONE: every other machine) store_rwinfo
+// does nothing and eat_cycles only counts the cycles; they are called at every memory access and
+// every opcode, so these fast paths are inline: the same work, without a call (lvgl-mpy-linux).
+static inline void eat_cycles(int type, int cycles)
+{
+	if (m_ula_variant != ULA_VARIANT_NONE || type == CYCLES_UNCONTENDED) {
+		eat_cycles_full(type, cycles);
+		return;
+	}
+	Z80.ICount -= cycles;
+	m_tstate_counter += cycles;
+	if (m_insn_cb) m_insn_cb(cycles);
+	if (m_tstate_counter >= m_cycles_per_frame) {
+		m_raster_cb(m_cycles_per_frame); // end frame
+		m_raster_cb(-1); // notify start next frame
+		m_tstate_counter -= m_cycles_per_frame;
+	}
+}
+
+static inline UINT8 store_rwinfo(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg)
+{
+	if (m_ula_variant == ULA_VARIANT_NONE) return 0;
+	return store_rwinfo_full(addr, val, flags, dbg);
+}
