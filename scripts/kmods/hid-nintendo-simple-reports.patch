+/*
+ * The simple report a Pro Controller sends before it is set to full reports
+ * (0x3F): buttons B A Y X L R ZL ZR, then - + LS RS Home Capture, a hat
+ * (0 up, clockwise, 8 centred) and four 16-bit sticks, centred near 0x8000.
+ */
+#define JC_INPUT_SIMPLE 0x3F
+
+static s32 joycon_simple_stick(const u8 *data)
+{
+	s32 value = (s32)get_unaligned_le16(data) - 0x8000;
+
+	return clamp(value, (s32)-JC_MAX_STICK_MAG, (s32)JC_MAX_STICK_MAG);
+}
+
+static void joycon_parse_simple_report(struct joycon_ctlr *ctlr, u8 *data)
+{
+	static const s8 hat_x[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+	static const s8 hat_y[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+	struct input_dev *dev = ctlr->input;
+	u8 hat = data[3];
+
+	input_report_key(dev, BTN_SOUTH, data[1] & BIT(0));
+	input_report_key(dev, BTN_EAST, data[1] & BIT(1));
+	input_report_key(dev, BTN_WEST, data[1] & BIT(2));
+	input_report_key(dev, BTN_NORTH, data[1] & BIT(3));
+	input_report_key(dev, BTN_TL, data[1] & BIT(4));
+	input_report_key(dev, BTN_TR, data[1] & BIT(5));
+	input_report_key(dev, BTN_TL2, data[1] & BIT(6));
+	input_report_key(dev, BTN_TR2, data[1] & BIT(7));
+	input_report_key(dev, BTN_SELECT, data[2] & BIT(0));
+	input_report_key(dev, BTN_START, data[2] & BIT(1));
+	input_report_key(dev, BTN_THUMBL, data[2] & BIT(2));
+	input_report_key(dev, BTN_THUMBR, data[2] & BIT(3));
+	input_report_key(dev, BTN_MODE, data[2] & BIT(4));
+	input_report_key(dev, BTN_Z, data[2] & BIT(5));
+	input_report_abs(dev, ABS_HAT0X, hat < 8 ? hat_x[hat] : 0);
+	input_report_abs(dev, ABS_HAT0Y, hat < 8 ? hat_y[hat] : 0);
+	input_report_abs(dev, ABS_X, joycon_simple_stick(data + 4));
+	input_report_abs(dev, ABS_Y, joycon_simple_stick(data + 6));
+	input_report_abs(dev, ABS_RX, joycon_simple_stick(data + 8));
+	input_report_abs(dev, ABS_RY, joycon_simple_stick(data + 10));
+	input_sync(dev);
+}
